limite_y = 30; 
// O objeto poderá se mover até 60 pixels para baixo.

estado = 0; 
// 0 significa que ele está parado em cima, esperando.

timer = 45; 
// Isso evita que vários objetos façam a mesma coisa ao mesmo tempo.

iniciado = true; 
// Variável booleana (verdadeiro/falso).
